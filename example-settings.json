{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gemini CLI Settings Example with OpenAI Model Mapping",
  
  "// Authentication": "Choose either 'gemini-api-key' or 'openai-api-key'",
  "selectedAuthType": "openai-api-key",
  
  "// OpenAI Model Mapping": "Map Gemini model names to custom OpenAI-compatible models",
  "openaiModelMapping": {
    "gemini-2.5-pro": "kimi-k2-0711-preview",
    "gemini-2.5-flash": "kimi-k1-0701",
    "gemini-2.0-pro": "kimi-k2-0711-preview",
    "gemini-2.0-flash": "kimi-k1-0701",
    "gemini-1.5-pro": "kimi-k2-0711-preview",
    "gemini-1.5-flash": "kimi-k1-0701",
    "models/gemini-2.5-pro": "kimi-k2-0711-preview",
    "models/gemini-2.5-flash": "kimi-k1-0701"
  },
  
  "// Other Settings": "Additional configuration options",
  "theme": "default-dark",
  "showMemoryUsage": true,
  "vimMode": false,
  "telemetry": {
    "enabled": false
  }
}